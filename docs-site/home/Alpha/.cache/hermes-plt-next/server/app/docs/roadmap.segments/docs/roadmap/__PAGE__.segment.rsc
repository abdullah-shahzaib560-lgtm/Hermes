9:["$","h2",null,{"id":"phases","className":"mt-12 mb-4 flex items-center gap-3 font-heading text-2xl font-extrabold tracking-tight text-ink","children":["The phases",["$","svg",null,{"className":"h-5 w-5 opacity-60","viewBox":"0 0 60 60","fill":"none","aria-hidden":"true","children":[["$","path",null,{"d":"M30 6 C31 20, 30 26, 33 30 M30 6 C29 20, 30 26, 27 30 M30 54 C31 40, 30 34, 33 30 M30 54 C29 40, 30 34, 27 30 M6 30 C20 31, 26 30, 30 27 M6 30 C20 29, 26 30, 30 33 M54 30 C40 31, 34 30, 30 27 M54 30 C40 29, 34 30, 30 33","stroke":"#ff4126","strokeWidth":4,"strokeLinecap":"round"}],["$","circle",null,{"cx":"30","cy":"30","r":"2.5","fill":"#ff4126"}]]}]]}]
a:["$","$L19",null,{"title":"phases","code":"Phase 1 — Foundation\n  fetch, ingest, parse, normalize, validate, profile, inspect,\n  transform, export, Dataset, connector system, schema system\n\nPhase 2 — Reliable infrastructure\n  storage, versions, snapshots, provenance, lineage,\n  better validation & profiling, caching, query interface\n\nPhase 3 — Ecosystem\n  Hermes Finance, Defense, Healthcare, Trade, Energy, Climate,\n  Geopolitics, Corporate, Entity, Features\n\nPhase 4 — Scale\n  remote datasets, object storage, distributed processing,\n  continuous ingestion, large-dataset querying, cloud execution\n\nPhase 5 — Hermes Cloud\n  hosted datasets, APIs, dataset catalogs, continuous pipelines,\n  versioned data, team access, usage controls, enterprise infra"}]
b:["$","p",null,{"className":"my-4 font-body text-[16.5px] leading-relaxed text-ink","children":"The guiding philosophy: make high-quality data infrastructure accessible through one consistent developer experience. One engine, one ecosystem, any data."}]
