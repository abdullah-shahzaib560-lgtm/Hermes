f:["$","$L2",null,{"code":"stats = hermes.cache_stats()\nprint(stats)\n# {\n#   \"total_files\": 3,\n#   \"by_source\": {\"world_bank\": 2, \"imf\": 1},\n#   \"hits\": {\"world_bank\": 5},\n#   \"misses\": {\"world_bank\": 2},\n#   \"hit_rate\": {\"world_bank\": 0.71},\n#}\n\n# Purge cached files older than 7 days\nhermes.clear_cache(older_than=\"7d\")","title":"python"}]
