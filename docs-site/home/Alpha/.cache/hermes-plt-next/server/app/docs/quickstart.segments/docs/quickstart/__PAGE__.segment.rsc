8:["$","$L2",null,{"code":"import asyncio\nfrom hermes import Hermes\n\nhermes = Hermes(\n    opensanction_api=\"x\",\n    new_data_api=\"x\",\n    sec_username=\"me@example.com\",\n    sec_email=\"me@example.com\",\n)\n\n# Annual GDP growth (%) for the United States\ndf = hermes.world_bank.fetch(\n    country_code=\"US\",\n    indicator_code=\"NY.GDP.MKTP.KD.ZG\",\n    frequency=\"Y\",\n    per_page=1000,\n)\n\nprint(df.head())\n#       date indicator_id  ...   value   source\n# 0  2023-01-01  NY.GDP.MKTP.KD.ZG  ...  2.54  world_bank","title":"python"}]
